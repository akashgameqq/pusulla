rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.dailyCalorieGoal is int && data.dailyCalorieGoal >= 800 && data.dailyCalorieGoal <= 8000 &&
             data.dailyWaterGoalMl is int && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 10000 &&
             data.targetWeightKg is number && data.targetWeightKg >= 25 && data.targetWeightKg <= 350 &&
             data.currentWeightKg is number && data.currentWeightKg >= 25 && data.currentWeightKg <= 350 &&
             data.heightCm is int && data.heightCm >= 100 && data.heightCm <= 250 &&
             (!('focusGoal' in data) || (data.focusGoal is string && data.focusGoal.size() <= 300));
    }

    function isValidScheduleItem(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 800)) &&
             isValidDateKey(data.dateKey) &&
             data.startTime is string && data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 720 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.priority in ['Yuksek', 'Orta', 'Dusuk'] &&
             data.isCompleted is bool &&
             (!('completedAtEpochMs' in data) || (data.completedAtEpochMs is int && data.completedAtEpochMs >= 0)) &&
             data.repeatRule is string && data.repeatRule.size() >= 1 && data.repeatRule.size() <= 40 &&
             (!('reminderMinutesBefore' in data) || (data.reminderMinutesBefore is int && data.reminderMinutesBefore >= 0 && data.reminderMinutesBefore <= 1440));
    }

    function isValidWeightLog(data, userId) {
      return data.userId == userId &&
             data.weightKg is number && data.weightKg >= 25 && data.weightKg <= 350 &&
             (!('bodyFatPercent' in data) || (data.bodyFatPercent is number && data.bodyFatPercent >= 0 && data.bodyFatPercent <= 75)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
             isValidDateKey(data.dateKey);
    }

    function isValidMealLog(data, userId) {
      return data.userId == userId &&
             data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 140 &&
             data.mealType in ['Kahvalti', 'Ogle', 'Aksam', 'Ara Ogun'] &&
             data.calories is int && data.calories >= 0 && data.calories <= 10000 &&
             data.proteinG is number && data.proteinG >= 0 && data.proteinG <= 1000 &&
             data.carbsG is number && data.carbsG >= 0 && data.carbsG <= 1000 &&
             data.fatG is number && data.fatG >= 0 && data.fatG <= 1000 &&
             data.portionLabel is string && data.portionLabel.size() >= 1 && data.portionLabel.size() <= 80 &&
             data.sourceEngine is string && data.sourceEngine.size() >= 1 && data.sourceEngine.size() <= 80 &&
             data.confidencePercent is int && data.confidencePercent >= 0 && data.confidencePercent <= 100 &&
             isValidDateKey(data.dateKey);
    }

    function isValidDailyWellness(data, userId, dateKey) {
      return data.userId == userId &&
             data.dateKey == dateKey &&
             isValidDateKey(data.dateKey) &&
             data.waterMl is int && data.waterMl >= 0 && data.waterMl <= 15000 &&
             data.focusMinutes is int && data.focusMinutes >= 0 && data.focusMinutes <= 1440 &&
             data.moodScore is int && data.moodScore >= 1 && data.moodScore <= 5 &&
             data.energyScore is int && data.energyScore >= 1 && data.energyScore <= 5 &&
             (!('reflectionNote' in data) || (data.reflectionNote is string && data.reflectionNote.size() <= 1000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'dailyCalorieGoal', 'dailyWaterGoalMl', 'targetWeightKg', 'currentWeightKg', 'heightCm', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'dailyCalorieGoal', 'dailyWaterGoalMl', 'targetWeightKg', 'currentWeightKg', 'heightCm', 'focusGoal', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'dailyCalorieGoal', 'dailyWaterGoalMl', 'targetWeightKg', 'currentWeightKg', 'heightCm', 'focusGoal', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /scheduleItems/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().keys().hasAll(['userId', 'title', 'dateKey', 'startTime', 'durationMinutes', 'category', 'priority', 'isCompleted', 'repeatRule', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'notes', 'dateKey', 'startTime', 'durationMinutes', 'category', 'priority', 'isCompleted', 'completedAtEpochMs', 'repeatRule', 'reminderMinutesBefore', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidScheduleItem(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(itemId) &&
                         isValidScheduleItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'completedAtEpochMs', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'dateKey', 'startTime', 'durationMinutes', 'category', 'priority', 'isCompleted', 'completedAtEpochMs', 'repeatRule', 'reminderMinutesBefore', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /weightLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['userId', 'weightKg', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'weightKg', 'bodyFatPercent', 'note', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidWeightLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidWeightLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['weightKg', 'bodyFatPercent', 'note', 'dateKey', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /mealLogs/{mealId} {
        allow get: if isOwner(userId) && isValidId(mealId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(mealId) &&
                         incoming().keys().hasAll(['userId', 'foodName', 'mealType', 'calories', 'proteinG', 'carbsG', 'fatG', 'portionLabel', 'sourceEngine', 'confidencePercent', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'foodName', 'mealType', 'calories', 'proteinG', 'carbsG', 'fatG', 'portionLabel', 'sourceEngine', 'confidencePercent', 'dateKey', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidMealLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(mealId) &&
                         isValidMealLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['foodName', 'mealType', 'calories', 'proteinG', 'carbsG', 'fatG', 'portionLabel', 'sourceEngine', 'confidencePercent', 'dateKey', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      match /dailyWellness/{dateKey} {
        allow get: if isOwner(userId) && isValidDateKey(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'waterMl', 'focusMinutes', 'moodScore', 'energyScore', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'waterMl', 'focusMinutes', 'moodScore', 'energyScore', 'reflectionNote', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidDailyWellness(incoming(), userId, dateKey);

        allow update: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         isValidDailyWellness(incoming(), userId, dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['waterMl', 'focusMinutes', 'moodScore', 'energyScore', 'reflectionNote', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidDateKey(dateKey);
      }
    }
  }
}
