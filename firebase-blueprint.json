{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User personal development profile, fitness and nutrition goals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "displayName": { "type": "string", "description": "Display name." },
        "dailyCalorieGoal": { "type": "integer", "description": "Daily calorie target in kcal." },
        "dailyWaterGoalMl": { "type": "integer", "description": "Daily water target in milliliters." },
        "targetWeightKg": { "type": "number", "description": "Goal body weight in kg." },
        "currentWeightKg": { "type": "number", "description": "Latest body weight in kg." },
        "heightCm": { "type": "integer", "description": "Height in centimeters." },
        "focusGoal": { "type": "string", "description": "Personal development primary goal." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "displayName", "dailyCalorieGoal", "dailyWaterGoalMl", "targetWeightKg", "currentWeightKg", "heightCm", "createdAt", "updatedAt"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Calendar-bound personal development task or habit schedule entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "title": { "type": "string", "description": "Task or habit title." },
        "notes": { "type": "string", "description": "Optional notes or coaching tip." },
        "dateKey": { "type": "string", "description": "ISO date YYYY-MM-DD." },
        "startTime": { "type": "string", "description": "24-hour time HH:mm." },
        "durationMinutes": { "type": "integer", "description": "Planned duration in minutes." },
        "category": { "type": "string", "description": "Category label." },
        "priority": { "type": "string", "description": "Priority level." },
        "isCompleted": { "type": "boolean", "description": "Whether completed." },
        "completedAtEpochMs": { "type": "integer", "description": "Epoch millis when completed." },
        "repeatRule": { "type": "string", "description": "Recurrence rule label." },
        "reminderMinutesBefore": { "type": "integer", "description": "Reminder lead time in minutes before start." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "title", "dateKey", "startTime", "durationMinutes", "category", "priority", "isCompleted", "repeatRule", "createdAt", "updatedAt"]
    },
    "WeightLog": {
      "title": "WeightLog",
      "description": "Daily body weight measurement log.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "weightKg": { "type": "number", "description": "Weight in kilograms." },
        "bodyFatPercent": { "type": "number", "description": "Optional body fat percentage." },
        "note": { "type": "string", "description": "Optional note." },
        "dateKey": { "type": "string", "description": "ISO date YYYY-MM-DD." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "weightKg", "dateKey", "createdAt", "updatedAt"]
    },
    "MealLog": {
      "title": "MealLog",
      "description": "Calorie and macronutrient meal entry from AI vision, local matcher, or manual input.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "foodName": { "type": "string", "description": "Recognized or entered food name." },
        "mealType": { "type": "string", "description": "Kahvalti, Ogle, Aksam, or Ara Ogun." },
        "calories": { "type": "integer", "description": "Calories in kcal." },
        "proteinG": { "type": "number", "description": "Protein in grams." },
        "carbsG": { "type": "number", "description": "Carbohydrates in grams." },
        "fatG": { "type": "number", "description": "Fat in grams." },
        "portionLabel": { "type": "string", "description": "Portion size description." },
        "sourceEngine": { "type": "string", "description": "Analysis provider or Manual." },
        "confidencePercent": { "type": "integer", "description": "Estimation confidence 0-100." },
        "dateKey": { "type": "string", "description": "ISO date YYYY-MM-DD." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "foodName", "mealType", "calories", "proteinG", "carbsG", "fatG", "portionLabel", "sourceEngine", "confidencePercent", "dateKey", "createdAt", "updatedAt"]
    },
    "DailyWellness": {
      "title": "DailyWellness",
      "description": "Daily hydration, deep focus minutes, mood/energy scores, and reflection journal.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "dateKey": { "type": "string", "description": "ISO date YYYY-MM-DD." },
        "waterMl": { "type": "integer", "description": "Water consumed in ml." },
        "focusMinutes": { "type": "integer", "description": "Completed deep focus timer minutes." },
        "moodScore": { "type": "integer", "description": "Mood rating 1-5." },
        "energyScore": { "type": "integer", "description": "Energy rating 1-5." },
        "reflectionNote": { "type": "string", "description": "Daily reflection or gratitude note." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "dateKey", "waterMl", "focusMinutes", "moodScore", "energyScore", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and wellness goals."
    },
    "/users/{userId}/scheduleItems/{itemId}": {
      "schema": { "$ref": "#/entities/ScheduleItem" },
      "description": "Calendar-based personal growth tasks and habits."
    },
    "/users/{userId}/weightLogs/{logId}": {
      "schema": { "$ref": "#/entities/WeightLog" },
      "description": "Body weight history logs."
    },
    "/users/{userId}/mealLogs/{mealId}": {
      "schema": { "$ref": "#/entities/MealLog" },
      "description": "Daily meal calorie and macro logs."
    },
    "/users/{userId}/dailyWellness/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyWellness" },
      "description": "Daily hydration, focus minutes, mood, energy, and reflection."
    }
  }
}
